{
  "name": "sentryscreen-web",
  "version": "1.0.0",
  "private": true,
  "description": "SentryScreen diagnostics receiver",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
