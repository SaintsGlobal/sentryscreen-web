# Copy to .env and fill in. README "Environment" describes each variable.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sentryscreen
ADMIN_TOKEN=          # at least 32 characters: openssl rand -base64 32
PORT=3000
LISTEN_HOST=0.0.0.0
TRUST_PROXY=0         # number of reverse-proxy hops in front of the server; 0 = none
LOG_LEVEL=info
# Optional rate-limit overrides (defaults in src/limits.ts)
DIAGNOSTICS_LIMIT_PER_IP_HOUR=
DIAGNOSTICS_LIMIT_GLOBAL_HOUR=
